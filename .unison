# .unicon
## cd ~/.unison ; ln -fs ~/zmq/.unison zmq.prf ; cd ~/zmq ; ls -la ~/.unison

# Название профиля (опционально)
label = zmq sync

# Корневые директории
root = /home/dponyatov/zmq
root = ssh://dev01@10.120.100.39//home/dev01/zmq

# Автоматизация
auto   = true
batch  = true
prefer = newer

# Игнорирование специфичных файлов и кэшей
# ignore = Name {.unison}
ignore = Name {.git}
ignore = Name {*~,*.log,*.sw?}
ignore = Name {bin,tmp,ref}
ignore = Name {doc/html,lib/pcpp}
ignore = Name {node_modules,.cache}
ignore = Name {*.pyc,__pycache__}
