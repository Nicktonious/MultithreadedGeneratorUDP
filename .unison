# Название профиля (опционально)
label = pcapp_based sync

# Корневые директории
root = /home/dponyatov/pcapp_based
root = ssh://dev01@10.120.100.39//home/dev01/pcapp_based

# Автоматизация
auto   = true
batch  = true
prefer = newer

# Игнорирование специфичных файлов и кэшей
# ignore = Name {.unison}
ignore = Name {.git}
ignore = Name {*~,*.log,*.sw?}
ignore = Name {bin,doc/html,tmp,ref}
ignore = Name {node_modules,.cache}
ignore = Name {*.pyc,__pycache__}
